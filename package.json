{
  "name": "@c4605/react-components",
  "description": "Some useful React components",
  "type": "module",
  "main": null,
  "repository": "https://github.com/bolasblack/react-components",
  "author": "c4605 <bolasblack@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "lint": "node scripts/lint.ts",
    "compile": "lerna run compile",
    "test": "pnpm lint && pnpm compile && vitest run",
    "test:react-legacy": "node scripts/react_legacy_tests.ts",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "release": "lerna version --sign-git-tag --conventional-commits",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "pnpm compile && storybook build"
  },
  "dependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "coveralls": "^3.1.1",
    "git-hook-pure": "^3.3.0",
    "lint-staged": "^17.0.4",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "happy-dom": "^20.9.0",
    "lerna": "^10.0.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.23.0",
    "storybook": "^10.3.6",
    "tsdown": "^0.22.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "nx",
      "postinstall-postinstall"
    ],
    "onlyBuiltDependencies": [
      "git-hook-pure"
    ]
  }
}
