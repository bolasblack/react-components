{
  "name": "@c4605/react-components",
  "description": "Some useful React components",
  "type": "module",
  "main": null,
  "repository": "https://github.com/bolasblack/react-components",
  "author": "c4605 <bolasblack@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "lint": "eslint \"packages/**/src/**/*.{js,jsx,ts,tsx}\"",
    "compile": "lerna run compile",
    "test": "pnpm lint && pnpm compile && vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "release": "lerna version --sign-git-tag --conventional-commits",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "pnpm compile && storybook build"
  },
  "dependencies": {
    "@c4605/react-portal": "^0.5.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "coveralls": "^3.0.9",
    "git-hook-pure": "^3.0.0",
    "lint-staged": "^13.0.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.4.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-docs": "10.0.6",
    "@storybook/react": "10.0.6",
    "@storybook/react-vite": "10.0.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.0.6",
    "happy-dom": "^20.0.10",
    "lerna": "7.1.1",
    "storybook": "10.0.6",
    "tsup": "^8.5.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "patchedDependencies": {
      "lerna@7.1.1": "patches/lerna@7.1.1.patch"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "nx",
      "postinstall-postinstall"
    ],
    "onlyBuiltDependencies": [
      "git-hook-pure"
    ]
  }
}
